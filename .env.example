# Copie para .env na raiz; use valores sem aspas.
DB_URL=jdbc:postgresql://SEU_HOST_NEON:5432/SEU_BANCO?sslmode=require
DB_USERNAME=SEU_USUARIO
DB_PASSWORD=SUA_SENHA
MONGODB_URI=SUA_URI_MONGODB
MONGODB_DATABASE=db_ceris
JWT_SECRET_BASE64=SUA_CHAVE_BASE64_COMPARTILHADA_COM_AUTH

# Upstash: copie a URL da aba TCP, incluindo senha e TLS (rediss).
REDIS_URL=rediss://default:SUA_SENHA@SEU_ENDPOINT.upstash.io:6379

# Opcionais: os valores abaixo já são os padrões da aplicação.
PROFILE_DIETARY_RESTRICTIONS_CACHE_TTL_SECONDS=86400
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s
JWT_ISSUER=nexus-auth
PORT=8080
CORS_ALLOWED_ORIGINS=
